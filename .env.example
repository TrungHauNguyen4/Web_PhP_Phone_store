# Laptop Store - Environment Configuration
# Copy this file to .env.local and fill in your values

# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME="Laptop Store"
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Database - MySQL (XAMPP)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laptop_store
DB_USER=root
DB_PASSWORD=

# Session
SESSION_TIMEOUT=3600

# Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=public/uploads

# Email (if needed)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@laptopstore.com

# Azure Configuration (if deploying to Azure)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
